{
  "name": "wp-frappe-data-store",
  "version": "0.1.0",
  "description": "A @wordpress/data store for querying and mutating Frappe resources.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "demo:preview": "vite preview --config demo/vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@wordpress/data": ">=10.0.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.3",
    "@wordpress/components": "^36.0.0",
    "@wordpress/data": "latest",
    "@wordpress/dataviews": "^17.0.0",
    "@wordpress/element": "^8.1.0",
    "@wordpress/icons": "^15.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "latest",
    "typescript": "latest",
    "vite": "^8.1.0",
    "vitest": "latest"
  },
  "keywords": [
    "wordpress",
    "frappe",
    "gutenberg",
    "data-store"
  ],
  "license": "MIT"
}
